<style global>
  :root {
    /* Palette ultra sombre, très peu saturée */
    --bg: #020617;                 /* fond global quasi noir */
    --bg-alt: #020617;
    --accent: #64748b;             /* gris bleuté discret */
    --accent-soft: rgba(100, 116, 139, 0.15);
    --accent-2: #4b5563;
    --accent-3: #6b7280;
    --text-main: #e5e7eb;          /* texte principal */
    --text-soft: #6b7280;          /* texte secondaire */
    --border-subtle: rgba(55, 65, 81, 0.8);
  }

  * {
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: radial-gradient(
      circle at top,
      #020617 0,
      #020617 40%,
      #000000 100%
    );
    color: var(--text-main);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
      "Segoe UI", sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .shell {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .card {
    border-radius: 1rem;
    border: 1px solid var(--border-subtle);
    background: #020617; /* fond plein, très sombre */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
    padding: 1.4rem 1.6rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border-subtle);
    background: #020617;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #4b5563;
    box-shadow: 0 0 8px rgba(15, 23, 42, 0.9);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-logo {
    width: 32px;
    height: 32px;
    border-radius: 0.6rem;
    background: #020617;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .nav-title {
    line-height: 1.15;
  }

  .nav-title-main {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .nav-title-sub {
    font-size: 0.75rem;
    color: var(--text-soft);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.8rem;
  }

  .nav-link {
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
  }

  .nav-link:hover {
    border-color: var(--border-subtle);
    background: #020617;
    color: var(--text-main);
  }

  .nav-link--primary {
    border-color: var(--border-subtle);
    background: #020617;
    color: var(--text-main);
  }

  main {
    margin-top: 0.5rem;
  }

  /* Petits réglages typographiques généraux */
  h1,
  h2,
  h3 {
    letter-spacing: -0.02em;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 0.8rem;
    background: #020617;
    padding: 0.12rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(31, 41, 55, 0.9);
  }

  @media (max-width: 720px) {
    .shell {
      padding-inline: 1rem;
    }
    .card {
      padding: 1.25rem 1.3rem;
    }
    .nav {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
